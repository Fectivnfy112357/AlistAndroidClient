<?xml version="1.0" encoding="utf-8"?>
<!--
    Alist Client adaptive-icon foreground.

    White cloud (Material Symbols cloud, scaled 2.4x from its 24x24 viewbox,
    centered in the 72x72 safe zone) + dark-blue document peeking from
    inside the cloud. Reads as "cloud file storage", which is exactly
    what Alist v3 is — a multi-backend cloud file aggregator.

    The cloud is deliberately smaller than the safe zone so the brand
    gradient background (Brand500 → Brand700) is visible as a frame around
    it, instead of being completely covered by a full-bleed white cloud.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- White cloud silhouette.
         Bounds: x=25.2..82.8, y=34.8..73.2 (~80% of safe zone width,
         ~53% of safe zone height). Leaves a visible gradient frame. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M71.64 49.3 C70.01 41.02 62.74 34.8 54 34.8 C47.06 34.8 41.04 38.74 38.04 44.5 C30.82 45.26 25.2 51.38 25.2 58.8 C25.2 66.74 31.66 73.2 39.6 73.2 H70.8 C77.42 73.2 82.8 67.82 82.8 61.2 C82.8 54.86 77.88 49.73 71.64 49.3 Z" />

    <!-- Document body: rounded rect with a notched top-right corner.
         Brand700 dark blue contrasts strongly with the white cloud. -->
    <path
        android:fillColor="#FF2D7AD0"
        android:pathData="M 47 39 L 60 39 L 65 44 L 65 65 A 4 4 0 0 1 61 69 L 47 69 A 4 4 0 0 1 43 65 L 43 43 A 4 4 0 0 1 47 39 Z" />

    <!-- Document fold: small white triangle in the top-right,
         showing the "back" of the folded paper corner. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 60 39 L 60 44 L 65 44 Z" />
</vector>
